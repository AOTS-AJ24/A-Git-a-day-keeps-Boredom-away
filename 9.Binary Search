    //--------------------------------------------------------------------------------------------------------------------------------------------------


    public static int BSearch_logic(int []arr,int findNum) {
        int left = 0;
        int right = arr.length - 1;
        int ans =-1 ;

        while (left <= right) {
            int midIndex = (left + right) / 2;
            int midVal = arr[midIndex];

            if (findNum == midVal) {
                right = midIndex -1; // now to check if there are more occurences if then select the first occurence
                ans= midIndex;   // we store it here temproary and see if we find its first occurence before this index point


            }
            else if (findNum < midVal) {
                right = midIndex - 1; // It means number is less than mid value | bring Right pointer ro Mid Index -1 location
            }
            else {
                left = midIndex + 1;
            } // it means number is bigger than midValue| bring left pointer from index location zero to midIndex+1 , so now search from mid to end

        }
        return ans ;

    }

