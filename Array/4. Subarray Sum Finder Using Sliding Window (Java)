import java.util.Scanner;

public class Array_1 {
    public static void main(String [] args){  // my first dsa code : 21-11-2025

                Scanner sc = new Scanner(System.in);
        System.out.println(" how big in length array u want ? \n -> ");
                int n = sc.nextInt();
                int[] arr = new int[n];
        System.out.println("Enter the elements inside array: ");

        for ( int i = 0; i < n; i++) {
//                    arr[i] = sc.nextInt();  // takes input from user
//                    arr[i]= ((int)(Math.random()*100));   // take input randomly and as much as you want till 100
                    arr[i]= (i+1);  // takes input from i
                    System.out.print( arr[i] + "  is in  index location : " + i + "\n");
                }
        System.out.println("\nEnter the sum target you want : ");
                long target = sc.nextLong();

                int left = 0;
                long sum = 0;

                for (int right = 0; right < n; right++) {
                    sum += arr[right];  /// expand (left is stationary )to --> right

                    while (sum > target && left <= right) {
                        sum -= arr[left++]; // shrink from left --> to right (right is stationary)
                    }

                    if (sum == target) {
                        System.out.println("\n-------------------------------------------------------------");
                        System.out.println("The starting index location in array is : "+left + "\nThe ending index location in array is :  " + right);
                        System.out.println("-------------------------------------------------------------");
                        return; // exit the program because answer found
                    }
                }

                System.out.println("What you are finding \' "+ target +" \' it ain't here buddy ");

    }

}
