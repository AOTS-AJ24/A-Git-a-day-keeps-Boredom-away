package Array;


import java.util.Arrays;
import java.util.Scanner;//Now writing a reverse function for array


public class Reverse {
    public static  void reverseFunction ( int[] nums, int left , int right ){

        while(left<right){

            int tmp = nums[left];
            nums [left]= nums[right];
            nums[right]=tmp;
            left++;
            right--;

        }
       System.out.println(Arrays.toString(nums));


    }





